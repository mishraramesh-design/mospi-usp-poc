# ─── PostgreSQL ───────────────────────────────────────────────────────────────
PG_HOST=postgres
PG_PORT=5432
PG_USER=appuser
PG_PASSWORD=apppassword
PG_DB=mospi_usp

# External postgres (VPS host DB, used by CI/CD deploy)
EXT_PG_HOST=93.127.194.188
EXT_PG_PORT=5432
EXT_PG_USER=appuser
EXT_PG_PASSWORD=apppassword

# ─── FastAPI ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-super-secret-key-32chars!!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── ODK Central ─────────────────────────────────────────────────────────────
ODK_URL=http://odk-central:8383
ODK_ADMIN_EMAIL=admin@mospi.gov.in
ODK_ADMIN_PASSWORD=MoSPI@2024

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=mospi-attachments

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Airflow ──────────────────────────────────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://appuser:apppassword@postgres:5432/airflow
AIRFLOW__CORE__FERNET_KEY=change-me-fernet-key-must-be-32-bytes=
AIRFLOW__WEBSERVER__SECRET_KEY=change-me-webserver-secret
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=MoSPI@2024

# ─── Superset ─────────────────────────────────────────────────────────────────
SUPERSET_SECRET_KEY=change-me-superset-secret-key
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=MoSPI@2024
SUPERSET_ADMIN_EMAIL=admin@mospi.gov.in

# ─── R Plumber ───────────────────────────────────────────────────────────────
R_API_PORT=8686

# ─── APISIX ──────────────────────────────────────────────────────────────────
APISIX_ADMIN_KEY=change-me-apisix-admin-key

# ─── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=MoSPI@2024

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPERSET_URL=http://localhost:8088
NEXT_PUBLIC_AIRFLOW_URL=http://localhost:8080
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3001
NEXT_PUBLIC_ODK_URL=http://localhost:8383
